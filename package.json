{
  "name": "yolnoma-plugin-dev",
  "version": "0.1.0",
  "description": "Official developer CLI and build tool for Yolnoma plugins",
  "author": "JK Software",
  "license": "MIT",
  "type": "module",
  "bin": {
    "yolnoma-plugin-dev": "./bin/yolnoma-plugin-dev.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "yolnoma",
    "plugin",
    "cli",
    "dev",
    "sdk"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
